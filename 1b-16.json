  "notes": [
    {
      "nid": "n1",
      "head": { "zh": "…… ， [[好 吗]] ？", "py": "… , hǎo ma ?", "id": "…, oke?" },
      "explanation": "Kalimat pernyataan + **好吗？** = mengusulkan sesuatu dan minta persetujuan lawan bicara. Nadanya sopan.",
      "examples": [ { "zh": "晚上 咱们 一起 看 电影 ， 好 吗 ？", "py": "wǎnshang zánmen yìqǐ kàn diànyǐng , hǎo ma ?", "id": "Nanti malam kita nonton film bareng, oke?" } ]
    },
    {
      "nid": "n2",
      "head": { "zh": "[[咱们]] 走 吧 。", "py": "zánmen zǒu ba .", "id": "Ayo kita pergi." },
      "explanation": "**咱们** = kita, **selalu termasuk** orang yang diajak bicara. **我们** bisa \"kita\" atau \"kami\" (tidak termasuk lawan bicara).",
      "examples": [ { "zh": "咱们 去 超市 吧 。", "py": "zánmen qù chāoshì ba .", "id": "Yuk kita ke supermarket." } ]
    },
    {
      "nid": "n3",
      "head": { "zh": "咱们 走 [[吧]] 。", "py": "zánmen zǒu ba .", "id": "Ayo kita pergi." },
      "explanation": "**吧** di akhir kalimat = mengajak atau menyarankan, mirip \"yuk / ayo\"."
    },
    {
      "nid": "n4",
      "head": { "zh": "我 [[很 少]] 看 。", "py": "wǒ hěn shǎo kàn .", "id": "Saya jarang menonton." },
      "explanation": "**很少 + verba** = jarang melakukan sesuatu. Lawannya **常常**.",
      "examples": [ { "zh": "我 很 少 喝 咖啡 。", "py": "wǒ hěn shǎo hē kāfēi .", "id": "Saya jarang minum kopi." } ]
    }
  ],

  "grammar": [
    {
      "gid": "g1",
      "kind": "grammar",
      "title": "Kata waktu sebagai keterangan",
      "explanation": "Kata waktu (晚上, 现在, 周末, 星期六…) diletakkan **sebelum verba** — boleh setelah subjek, atau di awal kalimat. **Tidak boleh** di akhir kalimat seperti bahasa Indonesia.",
      "patterns": [
        [ { "kind": "slot", "text": "Subjek" }, { "kind": "slot", "text": "Waktu" }, { "kind": "slot", "text": "Verba" }, { "kind": "slot", "text": "Objek" } ],
        [ { "kind": "slot", "text": "Waktu" }, { "kind": "slot", "text": "Subjek" }, { "kind": "slot", "text": "Verba" }, { "kind": "slot", "text": "Objek" } ]
      ],
      "examples": [
        { "zh": "我 晚上 复习 课文 。", "py": "wǒ wǎnshang fùxí kèwén .", "id": "Malam hari saya mengulang teks pelajaran." },
        { "zh": "星期六 我们 去 公园 。", "py": "Xīngqīliù wǒmen qù gōngyuán .", "id": "Hari Sabtu kami ke taman." }
      ],
      "mistakes": [ { "wrong": "我去超市晚上。", "right": "我晚上去超市。", "why": "Kata waktu harus sebelum verba." } ]
    },
    {
      "gid": "g2",
      "kind": "grammar",
      "title": "还是 dan 或者 — dua-duanya \"atau\"",
      "explanation": "**还是** dipakai dalam **kalimat tanya** pilihan (lawan bicara harus memilih).\n\n**或者** dipakai dalam **kalimat pernyataan** (dua-duanya mungkin).",
      "patterns": [
        [ { "kind": "slot", "text": "A" }, { "kind": "fixed", "text": "还是", "pinyin": "háishi" }, { "kind": "slot", "text": "B" }, { "kind": "fixed", "text": "？" } ],
        [ { "kind": "slot", "text": "A" }, { "kind": "fixed", "text": "或者", "pinyin": "huòzhě" }, { "kind": "slot", "text": "B" }, { "kind": "fixed", "text": "。" } ]
      ],
      "examples": [
        { "zh": "你 喝 茶 还是 喝 咖啡 ？", "py": "nǐ hē chá háishi hē kāfēi ?", "id": "Kamu minum teh atau kopi?" },
        { "zh": "周末 我 去 公园 或者 去 超市 。", "py": "zhōumò wǒ qù gōngyuán huòzhě qù chāoshì .", "id": "Akhir pekan saya ke taman atau ke supermarket." }
      ],
      "mistakes": [ { "wrong": "你喝茶或者喝咖啡？", "right": "你喝茶还是喝咖啡？", "why": "Pertanyaan pilihan memakai 还是." } ]
    }
  ],

